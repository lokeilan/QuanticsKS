# Generated calculations, historical bundles, and local tools stay on disk.
/results/
/outputs/
/deliverables/
/baselines/
/vendor/
/.chart-data-*/
/.tooling/
/numerics-failures/

# Local development and validation files.
/AGENTS.md
/.JuliaFormatter.toml
/test/
/tests/
/scripts/

# Publish only the user guides and basic runnable examples.
/docs/*
!/docs/algorithm.md
!/docs/configuration.md
!/docs/structure.md
/inputs/*
!/inputs/h4.toml
!/inputs/helium.toml
!/inputs/propagation.toml

# Caches, process receipts, and generated binary states.
__pycache__/
*.py[cod]
*.pid
*.log
*.jls
*.h5
*.hdf5
*.npy
*.npz

# Local credentials and editor state.
.env
.env.*
!.env.example
*.pem
*.key
.DS_Store
Thumbs.db
.vscode/
.idea/
